---
import Layout from '@layouts/Layout.astro'
import Carousel from '@components/carousel'
import Featured from '@components/featured'
import Location from '@components/location'
// import Testimonials from '@components/testimonials'
import Shopping from '@components/shopping'
import Contact from '@components/contact'
import { MapPin, Phone, Mail } from '@lucide/astro'
import type { Flower } from '@interfaces/carousel'
import products from '@data/products.json'

const phone = '977445864'
const email = 'contacto@entrerozas.pe'

const allFlowers = products as Flower[]

// Selección curada para el carrusel principal: piezas emblemáticas y de mayor valor.
const carouselIds = [7, 93, 49, 140]
const flowers = carouselIds
    .map((id) => allFlowers.find((flower) => flower.id === id))
    .filter((flower): flower is Flower => Boolean(flower))

// Selección curada para la vitrina "Nuestras Colecciones": opciones populares y accesibles.
const featuredIds = [1, 61, 70, 4]
const featuredFlowers = featuredIds
    .map((id) => allFlowers.find((flower) => flower.id === id))
    .filter((flower): flower is Flower => Boolean(flower))

// El diálogo "Ver más productos" muestra el catálogo completo descargado de WhatsApp.
const moreFlowers = allFlowers
// const testimonials = [
//     {
//         name: 'Sarah Johnson',
//         role: 'Wedding Client',
//         review: 'The arrangements were absolutely stunning! Every flower was fresh and beautiful. Thank you for making our special day perfect.',
//         rating: 5,
//     },
//     {
//         name: 'Michael Chen',
//         role: 'Corporate Client',
//         review: 'Professional service and gorgeous flowers. We send Bloom & Blossom arrangements to all our important clients. Highly recommended!',
//         rating: 5,
//     },
//     {
//         name: 'Emma Rodriguez',
//         role: 'Regular Customer',
//         review: 'I love ordering from here. The quality is consistently excellent and they always deliver with a smile. Best florist in town!',
//         rating: 5,
//     },
// ]
const locationInfo = {
    address: 'Ramon Espinoza 10, Rímac 15001',
    addressLink: 'https://maps.app.goo.gl/ZvSGKjvAHodMKU1B7',
    phone: '977445864',
    email: 'contacto@entrerozas.pe',
    locationItems: [
        {
            icon: MapPin,
            name: 'Dirección',
            linkRef: 'https://maps.app.goo.gl/ZvSGKjvAHodMKU1B7',
            text: 'Ramon Espinoza 10, Rímac 15001',
        },
        {
            icon: Phone,
            name: 'Teléfono',
            linkRef: `tel:+51${phone}`,
            text: phone,
        },
        {
            icon: Mail,
            name: 'Email',
            linkRef: `mailto:${email}`,
            text: email,
        },
    ],
    timeSchedule: ['Lun - Vier: 8:00 am - 5:00 pm', 'Sab: 8:00 am - 1:00 pm'],
}

const structuredData = {
    '@context': 'https://schema.org',
    '@type': 'Florist',
    name: 'Entre Rozas',
    image: new URL('/flowers-rose-bouquet.webp', Astro.site).toString(),
    url: Astro.site?.toString(),
    telephone: `+51${phone}`,
    email,
    priceRange: '$$',
    address: {
        '@type': 'PostalAddress',
        streetAddress: 'Ramón Espinoza 10',
        addressLocality: 'Rímac',
        addressRegion: 'Lima',
        postalCode: '15001',
        addressCountry: 'PE',
    },
    openingHoursSpecification: [
        {
            '@type': 'OpeningHoursSpecification',
            dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
            opens: '08:00',
            closes: '17:00',
        },
        {
            '@type': 'OpeningHoursSpecification',
            dayOfWeek: ['Saturday'],
            opens: '08:00',
            closes: '13:00',
        },
    ],
}
---

<Layout>
    <script
        type="application/ld+json"
        set:html={JSON.stringify(structuredData)}
    />
    <Carousel flowers={flowers} />
    <Featured flowers={featuredFlowers} moreFlowers={moreFlowers} />
    <Location locationInfo={locationInfo} />
    <!-- <Testimonials testimonials={testimonials} /> -->
    <Shopping />
    <Contact />
</Layout>
